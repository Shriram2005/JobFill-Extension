{
  "manifest_version": 3,
  "name": "JobFill — Assisted Job Application Filler",
  "version": "1.0.0",
  "description": "Fills job application forms from your profile.json. Matches obvious fields locally for free, asks Gemini only for what's left, and never submits without you.",
  "permissions": ["storage", "activeTab", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["profile.json", "memory.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
